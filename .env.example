# ============================================
# РПКМ — Калькулятор ремонта. Переменные окружения
# Скопируйте в .env на сервере и заполните.
# ============================================

# ── Общее ──
NODE_ENV=production
PORT=3001               # РПКМ на 3001 (VidFlex/VideoAI занимает 3000 на этом же сервере)
# Публичный адрес сайта (для ссылок и redirect после оплаты ЮKassa)
APP_URL=https://ddrpkm.ru

# ── База данных (PostgreSQL) ──
# Тот же PostgreSQL, что у VideoAI, но ОТДЕЛЬНАЯ база rpkm:
# postgresql://rpkm:ПАРОЛЬ@localhost:5432/rpkm
DATABASE_URL=

# ── Авторизация ──
JWT_SECRET=            # openssl rand -base64 32
ADMIN_PASSWORD=        # пароль для входа в /admin

# ── Email: SMTP Mail.ru (основной, как на VideoAI/VidFlex) ──
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=noreply@ddrpkm.ru
SMTP_PASS=             # пароль для внешних приложений Mail.ru (не основной пароль!)
EMAIL_FROM=noreply@ddrpkm.ru

# ── Email: фолбэк-провайдеры (нужны только пока сайт на Railway, где SMTP закрыт) ──
# UNISENDER_GO_API_KEY=
# UNISENDER_GO_API_URL=   # опц., если аккаунт не на go1: https://go2.unisender.ru/ru/transactional/api/v1/email/send.json
# BREVO_API_KEY=
# RESEND_API_KEY=

# ── Форма обратной связи ──
# Куда приходят сообщения с сайта (по умолчанию ddv1121@yandex.ru)
CONTACT_EMAIL=

# ── Платежи ЮKassa ──
# Сначала тестовый магазин (ShopID 1380535), боевой — позже той же переменной,
# без правки кода. Без этих двух сайт работает, кнопки оплаты недоступны.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
